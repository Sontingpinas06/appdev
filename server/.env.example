# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins.
# The Vite dev server proxies /api so this only matters for direct calls.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8080

# PostgreSQL (Phase 0 - not read by the app yet)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uniguide

# Auth (Phase 2)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
