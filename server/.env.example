# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins.
# The Vite dev server proxies /api so this only matters for direct calls.
# REQUIRED in production (an empty list would reflect any origin with creds).
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8080

# Reverse proxy: set to the number of hops (usually 1) when the API runs behind
# nginx/PM2/cloud so rate limits see real client IPs instead of the proxy's.
# REQUIRED in production: TRUST_PROXY=1 (behind proxy) or TRUST_PROXY=false
# (directly exposed). Never leave unset there.
# TRUST_PROXY=1

# Rate limits (per IP; in-memory, so one process per instance)
# API_RATE_LIMIT=2000   # all /api routes, 15-minute window
# AUTH_RATE_LIMIT=150   # register + login, 15-minute window
# ORDER_RATE_LIMIT=100  # checkout, hourly window

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uniguide
# Or discrete variables (used when DATABASE_URL is unset):
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=uniguide
# DB_USER=postgres
# DB_PASSWORD=postgres
# Set to true for managed databases that require TLS
DB_SSL=false

# Dev shortcut: create tables at boot from the models. Production keeps this
# false and applies server/migrations/ with `npm run migrate` instead.
DB_SYNC=true

# Auth - required, must be long random strings in production
JWT_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Admin account seeded on boot (password is never overwritten if it exists)
# Required in production; the dev default is refused there.
ADMIN_NAME=BCP Administrator
ADMIN_EMAIL=admin@bcp.edu.ph
ADMIN_PASSWORD=Admin123!

# Payments
# auto    -> PayMongo when a secret key is set, built-in sandbox otherwise
# sandbox -> always the in-app test gateway (no external calls)
# paymongo-> require PayMongo (fails fast without PAYMONGO_SECRET_KEY)
PAYMENT_PROVIDER=auto
# Server-side key from PayMongo Dashboard > Settings > Developers (sk_test_/sk_live_)
PAYMONGO_SECRET_KEY=
# Endpoint secret shown when you register the webhook in the PayMongo dashboard
PAYMONGO_WEBHOOK_SECRET=
# Signing secret for the sandbox/test webhook path (required in production
# when PAYMENT_PROVIDER resolves to the sandbox gateway)
PAYMENT_WEBHOOK_SECRET=
# Hosted checkout methods: documented values include card, gcash, qrph
PAYMONGO_PAYMENT_METHOD_TYPES=card,gcash,qrph
# Public origin used for hosted-checkout success/cancel return URLs
PUBLIC_URL=

# Photo-scan sizing
# auto    -> use a configured AI provider when one exists, sandbox otherwise
# sandbox -> always the deterministic hash-based simulator (no keys)
SCAN_PROVIDER=auto
# Maximum decoded image size accepted by POST /api/uniforms/scan
SCAN_MAX_BYTES=5242880
# Scan requests allowed per IP per 15-minute window
SCAN_RATE_LIMIT=60
