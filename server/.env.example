# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins.
# The Vite dev server proxies /api so this only matters for direct calls.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8080

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uniguide
# Or discrete variables (used when DATABASE_URL is unset):
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=uniguide
# DB_USER=postgres
# DB_PASSWORD=postgres
# Set to true for managed databases that require TLS
DB_SSL=false

# Create tables at boot. Set to false once migrations are introduced.
DB_SYNC=true

# Auth - required, must be long random strings in production
JWT_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Admin account seeded on boot (password is never overwritten if it exists)
ADMIN_NAME=BCP Administrator
ADMIN_EMAIL=admin@bcp.edu.ph
ADMIN_PASSWORD=Admin123!

# Payments
# auto    -> PayMongo when a secret key is set, built-in sandbox otherwise
# sandbox -> always the in-app test gateway (no external calls)
# paymongo-> require PayMongo (fails fast without PAYMONGO_SECRET_KEY)
PAYMENT_PROVIDER=auto
# Server-side key from PayMongo Dashboard > Settings > Developers (sk_test_/sk_live_)
PAYMONGO_SECRET_KEY=
# Endpoint secret shown when you register the webhook in the PayMongo dashboard
PAYMONGO_WEBHOOK_SECRET=
# Signing secret for the sandbox/test webhook path (required in production
# when PAYMENT_PROVIDER resolves to the sandbox gateway)
PAYMENT_WEBHOOK_SECRET=
# Hosted checkout methods: documented values include card, gcash, qrph
PAYMONGO_PAYMENT_METHOD_TYPES=card,gcash,qrph
# Public origin used for hosted-checkout success/cancel return URLs
PUBLIC_URL=
