# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins.
# The Vite dev server proxies /api so this only matters for direct calls.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8080

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uniguide
# Or discrete variables (used when DATABASE_URL is unset):
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=uniguide
# DB_USER=postgres
# DB_PASSWORD=postgres
# Set to true for managed databases that require TLS
DB_SSL=false

# Create tables at boot. Set to false once migrations are introduced.
DB_SYNC=true

# Auth - required, must be long random strings in production
JWT_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Admin account seeded on boot (password is never overwritten if it exists)
ADMIN_NAME=BCP Administrator
ADMIN_EMAIL=admin@bcp.edu.ph
ADMIN_PASSWORD=Admin123!
